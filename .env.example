TELEGRAM_BOT_TOKEN=123456:replace_me
TELEGRAM_WEBHOOK_SECRET=change_me
MINI_APP_URL=https://your-domain.example
PORT=3000
NODE_ENV=production
# Yandex organization search
YANDEX_SEARCH_API_KEY=replace_me
# Yandex Maps JavaScript API key for the map inside the Mini App
YANDEX_MAPS_JS_API_KEY=replace_me
# Automated fines provider (official/licensed/contracted provider required)
FINES_API_URL=
FINES_API_TOKEN=

# Optional Telegram communities: JSON map "MAKE MODEL": "https://t.me/your_chat"
COMMUNITY_CHATS_JSON={}

# Parts catalog / OEM diagrams (licensed provider recommended)
PARTS_PROVIDER=free
LAXIMO_URL=https://ws.laximo.ru/restApi/v1
LAXIMO_USER=
LAXIMO_PASSWORD=

# Бесплатный каталог запчастей (публичный demo API; ключ пользователя не нужен)
FAPI_URL=https://fapi.iisis.ru/fapi/v2/
FAPI_DEMO_KEY_URL=https://gist.githubusercontent.com/serp83/652d191745773ef6d8b5a0a689479cd6/raw/demo-key.txt
# Для production можно задать персональный ключ FAPI:
# FAPI_API_KEY=
# Optional part price provider. The provider should return real supplier/market prices.
PARTS_PRICE_URL=
